---
import Base from '../layouts/Base.astro';
import FaqList from '../components/FaqList.astro';
import { tiers } from '../lib/pricing';
import type { Faq } from '../lib/site';

const title = 'Pricing | Contractor Revolution';
const description =
  'Contractor Revolution pricing. 5 users $239, 10 users $329, 20 users $429, 40 users $529, 75 users $729 a month. Annual prepay is 15% off. Setup is not discounted.';

const crumbs = [
  { name: 'Home', path: '/' },
  { name: 'Pricing', path: '/pricing' },
];

const faqs: Faq[] = [
  {
    q: 'Who counts as a user?',
    a: 'Anyone who logs in. Field and office are the same price.',
  },
  {
    q: 'Do lower tiers lose features?',
    a: 'No. Every tier includes every feature. The tier changes the included headcount, the setup, and the extra-user rate.',
  },
  {
    q: 'What does annual prepay change?',
    a: 'It takes 15% off the monthly fee, rounded to the nearest dollar, and that amount is paid up front for the year. Extra users get the same 15% off, rounded per user. Setup stays the same.',
  },
  {
    q: 'Is monthly a contract?',
    a: 'The monthly column is the no-commitment price. Annual prepay is paid for the year up front.',
  },
  {
    q: 'What is not in the price?',
    a: 'Payment processing, marketing tools, and a CRM. Contractor Revolution does not sell those.',
  },
  {
    q: 'How do I order?',
    a: 'Use the order page at contractor-revolution.co/order, call 864-437-1827, or email info@isomtechnologies.com.',
  },
];
---

<Base title={title} description={description} path="/pricing" crumbs={crumbs} faqs={faqs}>
  <div class="wrap page-hero">
    <p class="kicker">Rate card</p>
    <h1>One product. Priced by headcount.</h1>
    <p class="lede">
      Every tier includes every feature. A user is anyone who logs in, in the field or in the office. Monthly is the no-commitment price. Annual prepay takes 15% off the monthly fee, rounded to the nearest dollar. Setup is not discounted.
    </p>
  </div>
  <section class="section">
    <div class="wrap">
      <div class="table-scroll">
        <table>
          <caption>Contractor Revolution tiers. Annual is paid up front for the year.</caption>
          <thead>
            <tr>
              <th scope="col">Tier</th>
              <th scope="col">Users included</th>
              <th scope="col" class="num">Monthly</th>
              <th scope="col" class="num">Annual per month</th>
              <th scope="col" class="num">Paid for the year</th>
              <th scope="col" class="num">Setup</th>
              <th scope="col" class="num">Extra user</th>
            </tr>
          </thead>
          <tbody>
            {
              tiers.map((tier) => (
                <tr>
                  <th scope="row"><a href={`/order?seats=${tier.included}`}>{tier.name}</a></th>
                  <td>Up to {tier.included}</td>
                  <td class="num">${tier.monthly}</td>
                  <td class="num">${tier.annualMonthly}</td>
                  <td class="num">${tier.annualYear.toLocaleString('en-US')}</td>
                  <td class="num">{tier.setupFrom ? `From $${tier.setup.toLocaleString('en-US')}` : `$${tier.setup.toLocaleString('en-US')}`}</td>
                  <td class="num">${tier.extra} / mo</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
      <p class="fine">Extra users on annual prepay are also 15% off, rounded per user: Starter $16, Crew $16, Company $13, Pro $10, Enterprise $7. On a small screen, swipe the table sideways.</p>
    </div>
  </section>
  <section class="section">
    <div class="wrap">
      <h2>How extra users work</h2>
      <p class="prose">Seats past the included count are extra users at that tier's rate. Extra users reach the next tier's price before its user count, so the order moves up instead of stacking seats. The lower number is the one on the order.</p>
      <ul>
        <li>9 users stay on Starter. Starter plus 4 extra users is $315, which is less than Crew at $329.</li>
        <li>10 users move up to Crew. Starter plus 5 extra users would be $334, and Crew is $329.</li>
        <li>56 users stay on Pro. Pro plus 16 extra users is $721, which is less than Enterprise at $729.</li>
        <li>57 users move up to Enterprise. Pro plus 17 extra users would be $733, and Enterprise is $729.</li>
        <li>80 users is Enterprise: 75 included and 5 extra at $8 each.</li>
      </ul>
      <p><a class="button" href="/order">Price a seat count</a></p>
    </div>
  </section>
  <section class="section">
    <div class="wrap">
      <h2>What setup pays for</h2>
      <ul>
        <li>Your logo and colors on the instance.</li>
        <li>Admin login, crew roster, and PINs.</li>
        <li>Jobs and locations.</li>
        <li>A smoke test and training.</li>
        <li>Company and above: a materials catalog import and starting PTO balances.</li>
        <li>Enterprise: data migration. Setup starts at $9,500.</li>
      </ul>
      <p>The system is customized to your exact processes. That work is the setup fee, and it is not waived on annual prepay.</p>
    </div>
  </section>
  <FaqList faqs={faqs} />
</Base>
