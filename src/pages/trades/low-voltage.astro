---
import Base from '../../layouts/Base.astro';
import FaqList from '../../components/FaqList.astro';
import type { Faq } from '../../lib/site';

const title = 'Low-voltage and fiber time tracking | Contractor Revolution';
const description =
  'Time tracking, work orders, PTO, and billing for low-voltage and fiber crews. Isom Technologies uses Contractor Revolution for its own low-voltage and fiber work.';

const crumbs = [
  { name: 'Home', path: '/' },
  { name: 'Trades', path: '/trades' },
  { name: 'Low voltage and fiber', path: '/trades/low-voltage' },
];

const faqs: Faq[] = [
  {
    q: 'Does Isom Technologies use Contractor Revolution on its own jobs?',
    a: 'Yes. Isom Technologies uses Contractor Revolution for its own low-voltage and fiber work: time tracking, work orders, PTO, and billing.',
  },
  {
    q: 'Can more than one tech log time on the same pull?',
    a: 'Yes. A work order holds the site, the assigned lead, the rest of the crew, and the hours each person logs.',
  },
  {
    q: 'Is this the same company as Isom Electric?',
    a: 'No. Isom Technologies builds Contractor Revolution and also does low-voltage and fiber work. Isom Electric is an electrical contractor and a separate user of the product.',
  },
];
---

<Base title={title} description={description} path="/trades/low-voltage" crumbs={crumbs} faqs={faqs}>
  <div class="wrap page-hero">
    <p class="kicker">Low voltage and fiber</p>
    <h1>Hours on the pull, not in a group text.</h1>
    <p class="lede">
      Isom Technologies uses Contractor Revolution for its own low-voltage and fiber work: time tracking, work orders, PTO, and billing.
    </p>
  </div>
  <section class="section">
    <div class="wrap">
      <h2>One work order, several people</h2>
      <p class="prose">
        A data drop or a fiber backbone is rarely one person. The lead, the pullers, and the person terminating all need their hours on the same order, or the bill is short and payroll is a pile of texts. The work order shows the site, who is assigned, who else is on the crew, and the hours already logged.
      </p>
      <p class="prose">
        Techs enter time from the phone against that order. A note can say what got done, such as a material count or which end still needs labels. The office does not retype the day.
      </p>
      <h2>Billing waits until the work is actually done</h2>
      <p class="prose">
        Low-voltage jobs often pause for the other trades. The hours should not disappear during the pause, and they should not get billed before the labels and the test are finished. Finished work stays on the billing list until it is billed. Open work stays on the work order.
      </p>
      <h2>Payroll is a separate close</h2>
      <p class="prose">
        The weekly summary is regular hours, overtime, leave, and total paid hours. That file is for payroll. It does not clear the billing list. PTO is requested from the phone and approved in hours.
      </p>
      <p class="prose">
        This is not a test-equipment log, a labeling printer, or a CRM. It is the time, the work order, the PTO, and the bill. Your instance uses your logo and your colors.
      </p>
      <div class="actions">
        <a class="button" href="/pricing">See pricing</a>
        <a class="button secondary" href="/about">About Isom Technologies</a>
      </div>
    </div>
  </section>
  <FaqList faqs={faqs} />
</Base>
