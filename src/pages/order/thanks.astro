---
import Base from '../../layouts/Base.astro';

const title = 'Order received | Contractor Revolution';
const description = 'We have the order and will follow up at the email and phone you sent.';
const crumbs = [
  { name: 'Home', path: '/' },
  { name: 'Order', path: '/order' },
  { name: 'Received', path: '/order/thanks' },
];
---

<Base title={title} description={description} path="/order/thanks" crumbs={crumbs} robots="noindex">
  <div class="wrap page-hero">
    <h1>Order received.</h1>
    <p class="lede">We have what you sent and will follow up at the email and phone on the order.</p>
    <p class="prose">If you finished card checkout, Stripe has the payment and setup starts after it clears. If card checkout was not available, no payment was taken.</p>
    <p>Questions: <a href="tel:+18644371827">864-437-1827</a> or <a href="mailto:info@isomtechnologies.com">info@isomtechnologies.com</a>.</p>
    <div class="actions">
      <a class="button" href="/">Home</a>
      <a class="button secondary" href="/pricing">Pricing</a>
    </div>
  </div>
</Base>
