---
import Base from '../layouts/Base.astro';
import { company, mapUrl } from '../lib/site';

const title = 'About | Contractor Revolution';
const description =
  'Contractor Revolution is a product of Isom Technologies, 7205 US 76, Pendleton, SC 29670. Call 864-437-1827 or email info@isomtechnologies.com.';

const crumbs = [
  { name: 'Home', path: '/' },
  { name: 'About', path: '/about' },
];
---

<Base title={title} description={description} path="/about" crumbs={crumbs}>
  <div class="wrap page-hero">
    <p class="kicker">Product of Isom Technologies</p>
    <h1>Built by Isom Technologies.</h1>
    <p class="lede">
      Contractor Revolution is a time-tracking, work order, and billing app for contractors. It is a product of Isom Technologies. It is built on the same codebase as the Isom Time app.
    </p>
  </div>
  <section class="section">
    <div class="wrap">
      <p class="prose">
        Each contractor gets a separate instance. Your instance is branded with your own logo and colors. The system is customized to your exact processes. We set up the roster, the PINs, the jobs, and the locations, then train the people who will use it.
      </p>
      <p class="prose">
        Isom Technologies is in Pendleton, SC. The company also designs, installs, and tests structured cabling, fiber, wireless, AV, and security infrastructure. That work is described on <a href={company.url}>isomtechnologies.com</a>. Isom Technologies uses Contractor Revolution for its own low-voltage and fiber work.
      </p>
      <div class="contact-card">
        <h2>Contact</h2>
        <address>
          Isom Technologies<br />
          <a href={mapUrl}>{company.street}, {company.locality}, {company.region} {company.postal}</a><br />
          <a href={`tel:${company.phoneTel}`}>{company.phoneDisplay}</a><br />
          <a href={`mailto:${company.email}`}>{company.email}</a><br />
          Support: <a href={`mailto:${company.support}`}>{company.support}</a>
        </address>
      </div>
    </div>
  </section>
</Base>
