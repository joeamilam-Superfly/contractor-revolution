---
import Base from '../layouts/Base.astro';
import { company, mapUrl, productName } from '../lib/site';

const title = 'About | Contractor Revolution';
const description =
  'Contractor Revolution is a product created by Isom Technologies for other service businesses. Call 864-437-1827 or email info@isomtechnologies.com.';

const crumbs = [
  { name: 'Home', path: '/' },
  { name: 'About', path: '/about' },
];
---

<Base title={title} description={description} path="/about" crumbs={crumbs} includeCreator>
  <div class="wrap page-hero">
    <p class="kicker">About</p>
    <h1>About Contractor Revolution.</h1>
    <p class="lede">
      Contractor Revolution is a product created by Isom Technologies so other service-based businesses can have the same success Isom Technologies and its initial clients, Isom Electric and South Pointe Construction, have had.
    </p>
  </div>
  <section class="section">
    <div class="wrap">
      <p class="prose">
        Each shop gets a separate instance, with its own logo and colors, set up around the way that shop already runs work. The roster, the PINs, the jobs, and the locations are loaded at setup, and the people who will use it get training.
      </p>
      <div class="contact-card">
        <h2>Contact</h2>
        <address>
          {productName}<br />
          <a href={mapUrl}>{company.street}, {company.locality}, {company.region} {company.postal}</a><br />
          <a href={`tel:${company.phoneTel}`}>{company.phoneDisplay}</a><br />
          <a href={`mailto:${company.email}`}>{company.email}</a><br />
          Support: <a href={`mailto:${company.support}`}>{company.support}</a>
        </address>
      </div>
    </div>
  </section>
</Base>
