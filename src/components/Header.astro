---
const path = Astro.url.pathname.replace(/\/$/, "") || "/";
const items = [
  { href: path === "/" ? "#short" : "/#short", label: "How it works" },
  { href: "/pricing", label: "Pricing" },
  { href: "/compare", label: "Compare" },
  { href: "/about", label: "About" },
];
const current = (href) => (path === href ? "page" : undefined);
---

<header class="site-header">
  <div class="wrap nav-bar">
    <a class="wordmark" href="/" aria-current={current("/")}>
      <span class="mark" aria-hidden="true">CR</span>
      <span>Contractor Revolution</span>
    </a>
    <nav class="nav-links" aria-label="Primary">
      {items.map((item) => (
        <a href={item.href} aria-current={current(item.href)}>{item.label}</a>
      ))}
      <a class="button" href="/order" aria-current={current("/order")}>Order</a>
    </nav>
    <details class="nav-toggle">
      <summary>Menu</summary>
      <div class="menu">
        {items.map((item) => (
          <a href={item.href}>{item.label}</a>
        ))}
        <a href="/order">Order</a>
      </div>
    </details>
  </div>
</header>
